{
  "name": "governance-commons",
  "version": "0.1.0-dev.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @governance-commons/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @governance-commons/web typecheck",
    "api/start": "tsx apps/api/src/index.ts",
    "workflow/start": "tsx apps/workflow-worker/src/index.ts",
    "site/start": "tsx apps/site-runner/src/index.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "requirements": "python3 scripts/requirements.py"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fastify/swagger": "9.9.4",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "@temporalio/activity": "1.25.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tanstack/react-table": "8.21.3",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0"
  }
}
